# Local development only. Shared by Docker Compose and the host backend.
POSTGRES_DB=autopredict
POSTGRES_USER=autopredict
POSTGRES_PASSWORD=autopredict_local
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONNECT_TIMEOUT=3
# JSON array of permitted frontend origins; restart the backend after changes.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
